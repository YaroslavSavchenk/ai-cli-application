# Obsidian workspace config (memory/ vault) — machine-local, never shared
.obsidian/

# Node
node_modules/
npm-debug.log*

# Local runtime data
*.log
# Rotated server.log generations (server.log.1/.2) — *.log does not match them.
*.log.[0-9]
.env
.env.*

# Machine-local Claude Code config
.claude/settings.local.json

# Build output
web/dist/
# A restart builds into web/dist-next and keeps the old build as web/dist-prev
# while it swaps (server/webbuild.ts); both are transient, neither is ever
# committed — a crashed restart can leave one behind.
web/dist-next/
web/dist-prev/
*.tsbuildinfo

# Native WebView2 host build output (compiled exe + fetched WebView2 DLLs).
# Never commit binaries; rebuild with launcher/build-host.ps1.
launcher/host/build/

# Release packaging output (.github/workflows/release.yml writes the zip +
# SHA256SUMS.txt here). Produced on a CI runner; only ever appears locally if
# the packaging step is run by hand. Same rule: never commit binaries.
dist-release/
