# Obsidian workspace config (memory/ vault) — machine-local, never shared
.obsidian/

# Node
node_modules/
npm-debug.log*

# Local runtime data
*.log
# Rotated server.log generations (server.log.1/.2) — *.log does not match them.
*.log.[0-9]
.env
.env.*

# Machine-local Claude Code config
.claude/settings.local.json

# Build output
web/dist/
# A restart builds into web/dist-next and keeps the old build as web/dist-prev
# while it swaps (server/webbuild.ts); both are transient, neither is ever
# committed — a crashed restart can leave one behind.
web/dist-next/
web/dist-prev/
*.tsbuildinfo

# Native WebView2 host build output (compiled exe + fetched WebView2 DLLs).
# Never commit binaries; rebuild with launcher/build-host.ps1.
launcher/host/build/

# Bundle build scratch: scripts/build-bundle.sh caches the Node dist under
# build/node-cache/ and stages the bundle under build/bundle/<version>/. Both
# are large, machine-local and reproducible; the tarball itself lands in
# dist-release/ below.
build/

# Release packaging output (.github/workflows/release.yml writes the zip +
# SHA256SUMS.txt here). Produced on a CI runner; only ever appears locally if
# the packaging step is run by hand. Same rule: never commit binaries.
dist-release/

# The launcher config the Windows Setup writes beside the INSTALLED scripts
# (launcher/README.md). It never belongs in a clone: a stray copy here would
# outrank the derivation from the launcher's own location and silently point
# the launcher at another distro or app directory.
launcher/launcher-config.json
launcher/install-info.txt

# Installer payload: the Linux bundle tarball and the four native-host files
# CI drops here before running ISCC (installer/README.md). Binaries, never
# committed.
installer/payload/

# Personal Claude Code hook scripts (referenced from settings.local.json)
.claude/hooks/
